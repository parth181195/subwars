# Google Analytics Measurement ID
# Default: G-VDCGN0XGWE (can be overridden here)
# Get your Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-VDCGN0XGWE

# API Configuration
# For production, set to: http://35.238.192.19:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# Firebase Configuration
# Get these values from Firebase Console → Project Settings → Your apps → Web app
# Required for Firebase Authentication
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id

# Note: SHOW_QUIZ configuration is now in quiz-react/src/config/environment.ts
# Edit that file directly to enable/disable quiz features

